---
import '../styles/global.css';
import { pages, site, type PageId } from '../data/site';

interface Props { page: PageId; title?: string; description?: string; }
const { page, title, description = `${site.name} — ${site.role}. Selected work, services and experiments.` } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%231c1c1e'/%3E%3C/svg%3E" />
    <script is:inline>
      // Loader shows once per browser session; later visits land directly.
      try { if (sessionStorage.getItem('seen')) document.documentElement.classList.add('is-loaded', 'skip-intro'); } catch (e) {}
    </script>
  </head>
  <body class:list={[`is-${page}`]} data-page={page}>
    <div class="loader" aria-hidden="true">
      <div class="loader-inner">
        <div class="loader-mark"></div>
        <div class="loader-meta mono"><span class="loader-word">Loading</span><span class="loader-pct">0%</span></div>
      </div>
      <div class="loader-bar"></div>
    </div>

    <a class="logo" href="/" data-route aria-label={`${site.name} — home`}></a>
    <div class="shell">

      <div class="ctrl ctrl--view" role="group" aria-label="View">
        <button type="button" data-view="showcase" class="is-active">showcase</button>
        <button type="button" data-view="grid">grid</button>
        <button type="button" data-view="slider">slider</button>
      </div>
      <div class="ctrl ctrl--filter" role="group" aria-label="Space">
        <button type="button" class="is-active" aria-current="page">cases</button>
        <a href="/lab/" data-route data-lab-link><svg class="ctrl-ico" viewBox="0 0 48 48" aria-hidden="true" fill="currentColor"><path d="M22.14 6c-.46-.26-1.01-.26-1.46 0L9.31 12.7c-.55.33-.89.91-.89 1.56v13.58c0 .88.96 1.43 1.72.98l11.83-6.98c.55-.33.89-.92.89-1.56V7.26c0-.53-.27-1-.73-1.26Z"/><path d="M39.59 32.61c0-.14-.04-.27-.1-.39-.07-.17-.2-.29-.35-.37l-13.77-8.02c-.24-.14-.54.03-.54.31v2.89c0 .13.07.25.18.31l10.78 6.28-5.54 3.23-10-5.82c-.14-.08-.31.02-.31.18v2.72c0 .21.11.41.29.51l7.05 4.13-3.06 1.78c-.09.05-.2.05-.29 0l-7.9-4.6 2.26-1.34c.18-.11.29-.3.29-.51v-3.59c0-.11.06-.21.15-.27l4.42-2.62c.11-.06.18-.18.18-.31v-2.98c0-.28-.3-.45-.54-.31L9.01 31.85c-.59.35-.58 1.21 0 1.56l14.14 8.23c.29.17.61.26.93.26s.63-.08.91-.25l6.75-3.93 5.54-3.23 1.85-1.08c.14-.09.24-.2.32-.33.06-.12.1-.26.1-.39v-.08Z"/></svg>design lab</a>
      </div>

      <nav class="nav" aria-label="Main">
        <span class="nav-indicator" aria-hidden="true"></span>
        {pages.filter((p) => p.id !== 'lab').map((p) => (
          <a href={p.href} data-route data-nav={p.id} aria-current={(page === 'lab' ? 'work' : page) === p.id ? 'page' : undefined}>
            {p.label}
          </a>
        ))}
        <a class="sayhi-btn" href="/about/#say-hi" data-route data-sayhi aria-keyshortcuts="Enter" title="Say hi (Enter)"><span class="arrow" aria-hidden="true">↳</span> Say hi</a>
      </nav>
    </div>

    <div id="pages"><slot /></div>

    <div class="case-cursor" data-case-cursor aria-hidden="true"><span class="case-cursor-dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></div>

    <div class="case-layer" aria-hidden="true">
      <div class="case-backdrop" data-case-close></div>
      <div class="case-scroller" role="dialog" aria-modal="true" aria-label="Case study">
        <button class="case-close" type="button" data-case-close aria-label="Close case">✕</button>
        <div class="case-slot"><slot name="case" /></div>
      </div>
    </div>


    <script>
      import { boot } from '../scripts/app';
      boot();
    </script>
  </body>
</html>
