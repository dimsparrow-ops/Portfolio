---
import '../styles/global.css';
import { pages, site, type PageId } from '../data/site';
import geistUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

interface Props { page: PageId; title?: string; description?: string; }
const { page, title, description = `${site.name} — ${site.role}. Selected work, services and experiments.` } = Astro.props;
const fullTitle = title ? `${title} — Dim` : 'Dim';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%231c1c1e'/%3E%3C/svg%3E" />
    <script is:inline>
      // Loader shows once per browser session; later visits land directly.
      try { if (sessionStorage.getItem('seen')) document.documentElement.classList.add('is-loaded', 'skip-intro'); } catch (e) {}
      // theme before first paint (the switcher top-right stores it), so a dark visit never flashes white
      try { if (localStorage.getItem('theme') === 'dark') { document.documentElement.dataset.theme = 'dark'; document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#161618'); } } catch (e) {}
    </script>
  </head>
  <body class:list={[`is-${page}`]} data-page={page}>
    <div class="loader" aria-hidden="true">
      <div class="loader-inner">
        <div class="loader-mark"></div>
        <div class="loader-meta mono"><span class="loader-word">Loading</span><span class="loader-pct">0%</span></div>
      </div>
      <div class="loader-bar"></div>
    </div>

    <a class="logo" href="/" data-route aria-label={`${site.name} — home`}></a>
    <button class="theme-switch" type="button" data-theme-switch aria-label="Switch to dark theme">
      <span class="is-sun" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.01 4C12.562 4 13.01 4.448 13.01 5C13.01 5.552 12.562 6 12.01 6H12C11.448 6 11 5.552 11 5C11 4.448 11.448 4 12 4H12.01ZM7.06 6.05C7.613 6.05 8.06 6.498 8.06 7.05C8.06 7.603 7.613 8.05 7.06 8.05H7.05C6.498 8.05 6.05 7.603 6.05 7.05C6.05 6.498 6.498 6.05 7.05 6.05H7.06ZM16.96 6.05C17.512 6.05 17.96 6.498 17.96 7.05C17.96 7.603 17.512 8.05 16.96 8.05H16.95C16.397 8.05 15.95 7.603 15.95 7.05C15.95 6.498 16.397 6.05 16.95 6.05H16.96ZM8 12C8 9.791 9.791 8 12 8C14.209 8 16 9.791 16 12C16 14.209 14.209 16 12 16C9.791 16 8 14.209 8 12ZM5.01 11C5.562 11 6.01 11.448 6.01 12C6.01 12.552 5.562 13 5.01 13H5C4.448 13 4 12.552 4 12C4 11.448 4.448 11 5 11H5.01ZM19.01 11C19.562 11 20.01 11.448 20.01 12C20.01 12.552 19.562 13 19.01 13H19C18.448 13 18 12.552 18 12C18 11.448 18.448 11 19 11H19.01ZM7.06 15.95C7.613 15.95 8.06 16.397 8.06 16.95C8.06 17.502 7.613 17.95 7.06 17.95H7.05C6.498 17.95 6.05 17.502 6.05 16.95C6.05 16.397 6.498 15.95 7.05 15.95H7.06ZM16.96 15.95C17.512 15.95 17.96 16.397 17.96 16.95C17.96 17.502 17.512 17.95 16.96 17.95H16.95C16.397 17.95 15.95 17.502 15.95 16.95C15.95 16.397 16.397 15.95 16.95 15.95H16.96ZM12.01 18C12.562 18 13.01 18.448 13.01 19C13.01 19.552 12.562 20 12.01 20H12C11.448 20 11 19.552 11 19C11 18.448 11.448 18 12 18H12.01Z"/></svg></span>
      <span class="is-moon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.214 15.893C19.064 20.98 13.196 23.361 8.10801 21.212C3.02101 19.062 0.637014 13.195 2.78601 8.10701C4.35201 4.40201 7.97701 1.996 12 2C12.425 2 12.803 2.268 12.944 2.669C13.084 3.07 12.956 3.516 12.625 3.781C10.295 5.645 9.91701 9.045 11.781 11.375C12.806 12.658 14.358 13.405 16 13.405C17.642 13.405 19.194 12.658 20.219 11.375C20.484 11.044 20.93 10.916 21.331 11.056C21.732 11.197 22 11.575 22 12C22.004 13.337 21.736 14.662 21.214 15.893Z"/></svg></span>
    </button>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const btn = document.querySelector('[data-theme-switch]');
        const meta = document.querySelector('meta[name="theme-color"]');
        const sync = () => {
          const dark = root.dataset.theme === 'dark';
          btn.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
          meta?.setAttribute('content', dark ? '#161618' : '#ffffff');
        };
        sync();
        btn.addEventListener('click', () => {
          const dark = root.dataset.theme !== 'dark';
          root.classList.add('theme-fade');
          if (dark) root.dataset.theme = 'dark';
          else delete root.dataset.theme;
          try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
          sync();
          clearTimeout(btn._t);
          btn._t = setTimeout(() => root.classList.remove('theme-fade'), 450);
        });
      })();
    </script>
    <div class="shell">

      <div class="ctrl ctrl--view" role="group" aria-label="View">
        <button type="button" data-view="spiral" class="is-active">spiral</button>
        <button type="button" data-view="showcase">circle</button>
        <button type="button" data-view="slider">slider</button>
        {/* grid hidden for now — restore: <button type="button" data-view="grid">grid</button> */}
      </div>
      <div class="ctrl ctrl--filter" role="group" aria-label="Space">
        <button type="button" class="is-active" aria-current="page">cases</button>
        <a href="/lab/" data-route><svg class="ctrl-ico" viewBox="0 0 48 48" aria-hidden="true" fill="currentColor"><path d="M22.14 6c-.46-.26-1.01-.26-1.46 0L9.31 12.7c-.55.33-.89.91-.89 1.56v13.58c0 .88.96 1.43 1.72.98l11.83-6.98c.55-.33.89-.92.89-1.56V7.26c0-.53-.27-1-.73-1.26Z"/><path d="M39.59 32.61c0-.14-.04-.27-.1-.39-.07-.17-.2-.29-.35-.37l-13.77-8.02c-.24-.14-.54.03-.54.31v2.89c0 .13.07.25.18.31l10.78 6.28-5.54 3.23-10-5.82c-.14-.08-.31.02-.31.18v2.72c0 .21.11.41.29.51l7.05 4.13-3.06 1.78c-.09.05-.2.05-.29 0l-7.9-4.6 2.26-1.34c.18-.11.29-.3.29-.51v-3.59c0-.11.06-.21.15-.27l4.42-2.62c.11-.06.18-.18.18-.31v-2.98c0-.28-.3-.45-.54-.31L9.01 31.85c-.59.35-.58 1.21 0 1.56l14.14 8.23c.29.17.61.26.93.26s.63-.08.91-.25l6.75-3.93 5.54-3.23 1.85-1.08c.14-.09.24-.2.32-.33.06-.12.1-.26.1-.39v-.08Z"/></svg>design lab</a>
      </div>

      <nav class="nav" aria-label="Main">
        <span class="nav-indicator" aria-hidden="true"></span>
        {pages.filter((p) => p.id !== 'lab').map((p) => (
          <a href={p.href} data-route data-nav={p.id} aria-current={(page === 'lab' ? 'work' : page) === p.id ? 'page' : undefined}>
            {p.label}
          </a>
        ))}
        <a class="sayhi-btn" href="/about/#say-hi" data-route aria-keyshortcuts="Enter" title="Say hi (Enter)"><span class="arrow" aria-hidden="true">↳</span> <span class="sayhi-label">Say hi</span></a>
      </nav>
    </div>

    <div id="pages"><slot /></div>

    <div class="case-layer" aria-hidden="true">
      <div class="case-backdrop" data-case-close></div>
      <div class="case-scroller" role="dialog" aria-modal="true" aria-label="Case study">
        <button class="case-close" type="button" data-case-close aria-label="Close case">✕</button>
        <div class="case-slot"><slot name="case" /></div>
      </div>
    </div>


    <script>
      import { boot } from '../scripts/app';
      boot();
    </script>
  </body>
</html>
