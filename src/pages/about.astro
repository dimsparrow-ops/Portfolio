---
import Base from '../layouts/Base.astro';
import { site, intro, nowPlaying, records, timeline, socials } from '../data/site';
---
<Base page="about" title="About">
  <main class="page page--about about" data-page="about">
    <div class="about-content">
      <div class="about-col">
        <h1 class="sr-only">{site.name}</h1>
        <p class="intro" data-words>{intro.lead}<span class="dim">{intro.accent}</span>{intro.text}</p>
        <section class="now" aria-label={nowPlaying.label} data-records={JSON.stringify(records)}>
          <span class="now-line" aria-hidden="true"></span>
          <p class="now-label">{nowPlaying.label}</p>
          <div class="now-body">
            <button class="deck" type="button" data-deck aria-pressed="false" aria-label="Pull the record out of the sleeve">
              <span class="vinyl" aria-hidden="true">
                <span class="vinyl-disc" data-vinyl></span>
                <span class="vinyl-sheen"></span>
              </span>
              <span class="sleeve" aria-hidden="true"><img data-np="sleeve" src={records[0].sleeve} alt="" width="160" height="160" decoding="async" /></span>
            </button>
            <div class="track">
              <p class="track-artist" data-np="artist">{records[0].artist}</p>
              <p class="track-name" data-np="track">{records[0].track}</p>
              <p class="track-meta" data-np="meta">{records[0].meta}</p>
            </div>
          </div>
        </section>
        <ol class="timeline">
          {timeline.map((t) => (
            <li class="tl-item" data-ai={t.ai ? "" : undefined}>
              <span class="tl-when">{t.ai ? t.label : t.years}</span>
              {t.company && (
                <div class="tl-head">
                  <span class="tl-company">{t.company}</span>
                  <span class="tl-role">{t.role}</span>
                </div>
              )}
              <p>{t.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <section class="hi" id="say-hi" aria-label="Summon me">
      <div class="hi-word" data-hi role="img" aria-label="Summon me">
        <span>S</span><span>U</span><span>M</span><span>M</span><span>O</span><span>N</span><span class="sp"></span><span>M</span><span>E</span>
      </div>
      <div class="hi-links mono">
        <a href={`mailto:${site.email}`}>Email</a>{socials.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
      </div>
    </section>
  </main>
</Base>
