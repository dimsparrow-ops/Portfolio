---
import Base from '../layouts/Base.astro';
import { site, intro, timeline, socials } from '../data/site';
---
<Base page="about" title="About">
  <main class="page page--about about" data-page="about">
    <div class="about-content">
      <div class="about-col">
        <h1 class="sr-only">{site.name}</h1>
        <p class="intro" data-reveal>{intro.lead}<span class="dim">{intro.accent}</span>{intro.text}</p>
        <ol class="timeline">
          {timeline.map((t) => (
            <li class="tl-item" data-reveal data-ai={t.ai ? "" : undefined}>
              <span class="tl-when">{t.ai ? t.label : t.years}</span>
              {t.company && (
                <div class="tl-head">
                  <span class="tl-company">{t.company}</span>
                  <span class="tl-role">{t.role}</span>
                </div>
              )}
              <p>{t.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <section class="hi" id="say-hi" aria-label="Summon me">
      <div class="hi-word" data-hi role="img" aria-label="Summon me">
        <span>S</span><span>U</span><span>M</span><span>M</span><span>O</span><span>N</span><span class="sp"></span><span>M</span><span>E</span>
      </div>
      <div class="hi-links mono">
        <a href={`mailto:${site.email}`}>Email</a>{socials.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
      </div>
    </section>
  </main>
</Base>
