---
import Base from '../layouts/Base.astro';
import { site, timeline } from '../data/site';
---
<Base page="about" title="About">
  <main class="page page--about about" data-page="about">
    <div class="about-content">
      <a class="btn about-mail" href={`mailto:${site.email}`}>{site.email}</a>
      <section class="about-intro">
        <h1>{site.name}</h1>
        <p>Placeholder. {site.role} based in {site.location}. A short paragraph about how I work and what I care about — two or three sentences, calm and specific.</p>
        <p>Placeholder. Teams, products and clients worth naming go here, written as plain text.</p>
      </section>

      <ol class="timeline">
        {timeline.map((t) => (
          <li class="tl-item" data-reveal>
            <span class="tl-when mono">{t.when} · {t.where}</span>
            <h3>{t.title}</h3>
            <p>{t.text}</p>
          </li>
        ))}
      </ol>

    </div>

    <section class="hi" id="say-hi" aria-label="Summon me">
      <div class="hi-word" data-hi aria-label="Summon me">
        <span>S</span><span>U</span><span>M</span><span>M</span><span>O</span><span>N</span><span class="sp"></span><span>M</span><span>E</span>
      </div>
      <div class="hi-links mono">
        <a href={`mailto:${site.email}`}>Email</a><a href="#" target="_blank" rel="noopener">X / Twitter</a><a href="#" target="_blank" rel="noopener">LinkedIn</a><a href="#" target="_blank" rel="noopener">Instagram</a>
      </div>
    </section>
  </main>
</Base>
