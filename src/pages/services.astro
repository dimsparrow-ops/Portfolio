---
import Base from '../layouts/Base.astro';
import { services, site } from '../data/site';
---
<Base page="services" title="Services">
  <main class="page page--services" data-page="services">
    <section class="services">
      <h1 class="sr-only">Services</h1>
      <ul class="svc-list" data-svc-list>
        {services.map((s, i) => (
          <li class="svc-item" data-text={s.text} data-i={i}>
            <a href={`mailto:${site.email}`} aria-label={`${s.title} — email me`}><span>{s.title}</span></a>
          </li>
        ))}
      </ul>
    </section>
    <div class="svc-desc" data-svc-desc aria-hidden="true">
      <p class="svc-desc-text"><span data-svc-typed></span><span class="svc-caret" aria-hidden="true"></span></p>
      <div class="svc-desc-bar">
        <span class="svc-ai">dimAI <svg viewBox="0 0 24 24" fill="currentColor"><path d="M10 4l1.6 4.4L16 10l-4.4 1.6L10 16l-1.6-4.4L4 10l4.4-1.6zM18 13l.9 2.1L21 16l-2.1.9L18 19l-.9-2.1L15 16l2.1-.9z"/></svg></span>
        <span class="svc-think"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M12 5a3 3 0 0 0-5.7-1.3A3.5 3.5 0 0 0 4 7a3.5 3.5 0 0 0 .5 6.5A3.5 3.5 0 0 0 9 19a3 3 0 0 0 3 0M12 5a3 3 0 0 1 5.7-1.3A3.5 3.5 0 0 1 20 7a3.5 3.5 0 0 1-.5 6.5A3.5 3.5 0 0 1 15 19a3 3 0 0 1-3 0"/></svg>Think</span>
        <a class="svc-send" href={`mailto:${site.email}`} tabindex="-1">click to email me <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg></a>
      </div>
    </div>
  </main>
</Base>
