---
import Base from '../layouts/Base.astro';
import { services } from '../data/site';
---
<Base page="services" title="Services">
  <main class="page page--services" data-page="services">
    <section class="services">
      <h1 class="sr-only">Services</h1>
      <ul class="svc-list" data-svc-list>
        {services.map((s, i) => (
          <li class="svc-item" data-text={s.text} data-i={i}>
            <a href="/about/#say-hi" data-route data-sayhi><span>{s.title}</span></a>
          </li>
        ))}
      </ul>
    </section>
    <div class="svc-desc" data-svc-desc aria-hidden="true">
      <p class="svc-desc-text"><span data-svc-typed></span><span class="svc-caret" aria-hidden="true"></span><span class="svc-rest" data-svc-rest></span></p>
      <div class="svc-desc-bar">
        <span class="svc-plus"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M12 4v16M4 12h16"/></svg></span>
        <span class="svc-think"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M12 5a3 3 0 0 0-5.7-1.3A3.5 3.5 0 0 0 4 7a3.5 3.5 0 0 0 .5 6.5A3.5 3.5 0 0 0 9 19a3 3 0 0 0 3 0M12 5a3 3 0 0 1 5.7-1.3A3.5 3.5 0 0 1 20 7a3.5 3.5 0 0 1-.5 6.5A3.5 3.5 0 0 1 15 19a3 3 0 0 1-3 0"/></svg>Think</span>
        <span class="svc-send">click to email me <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg></span>
      </div>
    </div>
  </main>
</Base>
