---
import type { CollectionEntry } from 'astro:content';
import Ph from './Ph.astro';
interface Props { cases: CollectionEntry<'cases'>[]; }
const { cases } = Astro.props;
---
<main class="page page--work" data-page="work">
  <h1 class="sr-only">Selected work</h1>
  <canvas class="dots" data-dots aria-hidden="true"></canvas>
  <div class="stage is-showcase" data-stage>
    <div class="stage-world" data-world>
      {cases.map((c, i) => (
        <a
          class="card"
          href={`/work/${c.id}/`}
          data-case={c.id}
          data-title={c.data.title}
          data-platform={c.data.platform}
          aria-label={`${c.data.title} — ${c.data.task}`}
        >
          <span class="card-face">
            {c.data.cover
              ? <img src={c.data.cover} alt="" loading="eager" />
              : <Ph hue={c.data.hue} />}
            <span class="card-sheen" aria-hidden="true"></span>
            <span class="card-tags" aria-hidden="true">{c.data.services.map((s) => <span>{s}</span>)}</span>
          </span>
          <span class="card-task" aria-hidden="true">{c.data.task}</span>
          <span class="card-meta" aria-hidden="true">{c.data.client ?? c.data.title} • {c.data.country}, {c.data.year}</span>
        </a>
      ))}
    </div>
  </div>
</main>
