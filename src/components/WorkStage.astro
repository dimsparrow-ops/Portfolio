---
import type { CollectionEntry } from 'astro:content';
import Ph from './Ph.astro';
interface Props { cases: CollectionEntry<'cases'>[]; }
const { cases } = Astro.props;

// Two-tone hover headline: first sentence (or first 3 words when there is no full stop) in ink, the rest in grey.
const splitTask = (task: string): [string, string] => {
  const m = task.match(/^(.+?[.!?])\s+(.+)$/);
  if (m) return [m[1], m[2]];
  const words = task.split(' ');
  return [words.slice(0, 3).join(' '), words.slice(3).join(' ')];
};
const platformLabel = { desktop: 'Web', mobile: 'Mobile' } as Record<string, string>;
const chipsOf = (d: CollectionEntry<'cases'>['data']) =>
  [d.services[0], platformLabel[d.platform] ?? d.platform, String(d.year)];
---
<main class="page page--work" data-page="work">
  <h1 class="sr-only">Selected work</h1>
  {/* polka-dot field off for now — restore: <canvas class="dots" data-dots aria-hidden="true"></canvas> */}
  <div class="stage is-showcase" data-stage>
    <div class="stage-world" data-world>
      {cases.map((c, i) => (
        <a
          class="card"
          href={`/work/${c.id}/`}
          data-case={c.id}
          data-title={c.data.title}
          data-platform={c.data.platform}
          aria-label={`${c.data.title} — ${c.data.task}`}
        >
          <span class="card-face">
            {c.data.cover
              ? <img src={c.data.cover} alt="" loading="eager" decoding="async" />
              : <Ph hue={c.data.hue} />}
          </span>
          <span class="card-task" aria-hidden="true">
            <span class="lead">{splitTask(c.data.task)[0]}</span>{' '}<span class="rest">{splitTask(c.data.task)[1]}</span>
          </span>
          <span class="card-chips" aria-hidden="true">
            {chipsOf(c.data).map((t, i) => <span class="chip" style={`--i:${i}`}>{t}</span>)}
          </span>
        </a>
      ))}
    </div>
  </div>
</main>
